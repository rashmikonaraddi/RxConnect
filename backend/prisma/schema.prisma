// RxConnect Pharmacy Platform Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PHARMACIST
  DELIVERY_PARTNER
  ADMIN
}

enum PrescriptionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PLACED
  VERIFIED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  REJECTED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  phone        String?  @unique
  password     String
  role         Role     @default(CUSTOMER)

  employeeId   String?  @unique
  vehicle      String?
  isOnDuty     Boolean  @default(true)

  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  prescriptions Prescription[]
  customerOrders Order[]       @relation("CustomerOrders")
  deliveryJobs   Order[]       @relation("DeliveryPartnerJobs")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@index([branchId])
}

model Medicine {
  id                   String      @id @default(cuid())
  name                 String
  description          String?
  manufacturer         String
  category             String
  dosage               String
  price                Float
  imageUrl             String?
  prescriptionRequired Boolean     @default(false)
  inventories          Inventory[]
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

model Prescription {
  id         String             @id @default(cuid())
  imageUrl   String
  status     PrescriptionStatus @default(PENDING)
  uploadedAt DateTime           @default(now())

  userId     String
  user       User               @relation(fields: [userId], references: [id])

  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model Branch {
  id              String      @id @default(cuid())
  code            String?     @unique
  name            String
  address         String
  phone           String
  fulfillmentRate Float       @default(95.0)

  users           User[]
  orders          Order[]
  inventories     Inventory[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([name])
}

model Order {
  id                     String      @id @default(cuid())
  branchId               String
  branch                 Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  
  customerId             String
  customer               User        @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  
  deliveryPartnerId      String?
  deliveryPartner        User?       @relation("DeliveryPartnerJobs", fields: [deliveryPartnerId], references: [id], onDelete: SetNull)
  
  status                 OrderStatus @default(PLACED)
  totalAmount            Float       // Amount in INR ₹
  deliveryPayout         Float       @default(150.0) // Payout in INR ₹
  destination            String
  notes                  String?
  deliveryNotes          String?
  isPrescriptionVerified Boolean     @default(false) // Hard Gate Flag
  
  packedAt               DateTime?
  deliveredAt            DateTime?

  items                  OrderItem[]

  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@index([branchId, status])
  @@index([deliveryPartnerId])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicineName String
  quantity     Int
  price        Float
  isRx         Boolean  @default(false)
}

model Inventory {
  id         String   @id @default(cuid())
  quantity   Int
  threshold  Int

  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([medicineId, branchId])
  @@index([branchId])
  @@index([medicineId])
}
