model User {
  id       String @id @default(cuid())
  fullName String
  email    String @unique
  phone    String @unique
  password String
  role     Role   @default(CUSTOMER)

  employeeId String? @unique
  vehicle    String?
  isOnDuty   Boolean @default(false)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  id         String   @id @default(cuid())
  firstName  String
  lastName   String
  email      String   @unique
  phone      String   @unique
  password   String
  role Role @default(CUSTOMER)
  prescriptions Prescription[]

  customerOrders Order[] @relation("CustomerOrders")
  deliveryOrders Order[] @relation("DeliveryPartnerOrders")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([branchId])
}

model Medicine {
  id                   String      @id @default(cuid())
  name                 String
  description          String?
  manufacturer         String
  category             String
  dosage               String
  price                Float
  imageUrl             String?
  prescriptionRequired Boolean     @default(false)
  inventories          Inventory[]
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

enum PrescriptionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Prescription {
  id         String             @id @default(cuid())
  imageUrl   String
  status     PrescriptionStatus @default(PENDING)
  uploadedAt DateTime           @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  PLACED
  VERIFIED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  REJECTED
}

model User {
  id           String      @id @default(uuid())
  fullName     String
  email        String      @unique
  password     String
  phone        String?
  role         Role        @default(CUSTOMER)
  employeeId   String?
  vehicle      String?
  isOnDuty     Boolean     @default(true)
  branchId     String?
  branch       Branch?     @relation(fields: [branchId], references: [id])
  
  customerOrders Order[]   @relation("CustomerOrders")
  deliveryJobs   Order[]   @relation("DeliveryPartnerJobs")

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Branch {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  address         String
  phone           String
  fulfillmentRate Float    @default(95.0)

  users           User[]
  orders          Order[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Order {
  id                     String      @id @default(uuid())
  branchId               String
  branch                 Branch      @relation(fields: [branchId], references: [id])
  
  customerId             String
  customer               User        @relation("CustomerOrders", fields: [customerId], references: [id])
  
  deliveryPartnerId      String?
  deliveryPartner        User?       @relation("DeliveryPartnerJobs", fields: [deliveryPartnerId], references: [id])
  
  status                 OrderStatus @default(PLACED)
  totalAmount            Float       // Amount in INR ₹
  deliveryPayout         Float       @default(150.0) // Payout in INR ₹
  destination            String
  isPrescriptionVerified Boolean     @default(false) // Hard Gate Flag
  notes                  String?
  
  packedAt               DateTime?
  deliveredAt            DateTime?

  items                  OrderItem[]

  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicineName String
  quantity     Int
  price        Float
  isRx         Boolean @default(false)
  CANCELLED
}

model Order {
  id     String      @id @default(cuid())
  status OrderStatus @default(PLACED)

  totalAmount    Float
  deliveryPayout Float @default(0.0)

  destination   String
  deliveryNotes String?

  isPrescriptionVerified Boolean @default(false)

  packedAt    DateTime?
  deliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  customerId String
  customer   User   @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)

  deliveryPartnerId String?
  deliveryPartner   User?   @relation("DeliveryPartnerOrders", fields: [deliveryPartnerId], references: [id], onDelete: SetNull)

  @@index([branchId, status])
  @@index([deliveryPartnerId])
}

model Branch {
  id              String @id @default(cuid())
  name            String
  address         String
  phone           String
  fulfillmentRate Float  @default(100.0)

  users       User[]
  orders      Order[]
  inventories Inventory[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([name])
}

model Inventory {
  id String @id @default(cuid())

  quantity  Int
  threshold Int

  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([medicineId, branchId])
  @@index([branchId])
  @@index([medicineId])
}
