// RxConnect Pharmacy Platform Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PHARMACIST
  DELIVERY_PARTNER
  ADMIN
}

enum PrescriptionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PLACED
  VERIFIED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  REJECTED
  CANCELLED
}

model User {
  id                String   @id @default(uuid())
  fullName          String
  email             String   @unique
  phone             String?  @unique
  password          String
  role              Role     @default(CUSTOMER)
  employeeId        String?  @unique
  vehicle           String?
  isOnDuty          Boolean  @default(true)
  deliveryAddress   String?
  preferredPharmacy String?
  emergencyContact  String?
  branchId          String?
  branch            Branch?  @relation(fields: [branchId], references: [id])

  prescriptions  Prescription[]
  customerOrders Order[]        @relation("CustomerOrders")
  deliveryJobs   Order[]        @relation("DeliveryPartnerJobs")
  notifications  Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([branchId])
}

model Branch {
  id              String   @id @default(uuid())
  code            String?  @unique
  name            String
  address         String
  phone           String
  fulfillmentRate Float    @default(95.0)

  users       User[]
  orders      Order[]
  inventories Inventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Medicine {
  id                   String      @id @default(uuid())
  name                 String
  description          String?
  manufacturer         String
  category             String
  dosage               String
  price                Float
  imageUrl             String?
  prescriptionRequired Boolean     @default(false)
  inventories          Inventory[]
  orderItems           OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Inventory {
  id        String   @id @default(uuid())
  quantity  Int
  threshold Int      @default(10)

  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([medicineId, branchId])
  @@index([branchId])
  @@index([medicineId])
}

model Prescription {
  id              String             @id @default(uuid())
  imageUrl        String
  doctorName      String?
  notes           String?
  status          PrescriptionStatus @default(PENDING)
  rejectionReason String?
  uploadedAt      DateTime           @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id                     String      @id @default(uuid())
  branchId               String
  branch                 Branch      @relation(fields: [branchId], references: [id])
  customerId             String
  customer               User        @relation("CustomerOrders", fields: [customerId], references: [id])
  deliveryPartnerId      String?
  deliveryPartner        User?       @relation("DeliveryPartnerJobs", fields: [deliveryPartnerId], references: [id])

  status                 OrderStatus @default(PLACED)
  totalAmount            Float
  deliveryPayout         Float       @default(150.0)
  destination            String
  deliveryNotes          String?
  isPrescriptionVerified Boolean     @default(false)
  paymentStatus          String      @default("PENDING")
  paymentMethod          String?     @default("CARD")

  packedAt    DateTime?
  deliveredAt DateTime?

  items         OrderItem[]
  prescriptions Prescription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, status])
  @@index([deliveryPartnerId])
}

model OrderItem {
  id           String    @id @default(uuid())
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicineId   String?
  medicine     Medicine? @relation(fields: [medicineId], references: [id])
  medicineName String
  quantity     Int
  price        Float
  isRx         Boolean   @default(false)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role?
  branchId  String?
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
